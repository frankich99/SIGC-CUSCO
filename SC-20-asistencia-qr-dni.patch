+    /**
+     * Celda de la matriz CSV: estado, origen de la marca y minutos de permanencia (SC-32).
+     */
+    private function formatAttendanceCell(AttendanceRecord $record): string
+    {
+        $origin = match ($record->method) {
+            'dni_lector' => 'lector DNI',
+            'qr_proyeccion' => 'QR',
