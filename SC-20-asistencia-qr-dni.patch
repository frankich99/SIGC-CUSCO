@@ -0,0 +1,125 @@
+/**
+ * Live session roster returned by GET /courses/{course}/sessions/{session}/roster (SC-32, SC-33).
+ */
+export type RosterState =
+    | 'presente'
+    | 'tardanza'
+    | 'parcial'
+    | 'sin_salida'
+    | 'falta'
+    | 'en_sala'
+    | 'ausente';
+
+export type MarkType = 'entrada' | 'salida';
+
+export type MarkOrigin = 'dni_lector' | 'qr' | 'manual';
+
+export interface RosterParticipant {
+    id: number;
+    dni: string;
+    full_name: string;
+    state: RosterState;
+    recorded_at: string | null;
+    method: string | null;
+    minutes_present: number | null;
+    justification: string | null;
+    justified_at: string | null;
+    entry_at: string | null;
+    entry_origin: MarkOrigin | null;
+    exit_at: string | null;
+    exit_origin: MarkOrigin | null;
+}
+
+export interface RosterUnenrolledScan {
+    id: number;
+    dni: string;
+    type: MarkType;
+    reason: string;
+    scanned_at: string;
+}
+
+export interface SessionRoster {
+    session: number;
+    duration_minutes: number;
+    required_percent: number;
+    is_acta_closed: boolean;
+    summary: {
+        total: number;
+        presentes: number;
+        en_sala: number;
+        parciales: number;
+        sin_salida: number;
+        ausentes: number;
+        no_inscritos: number;
+    };
+    participants: RosterParticipant[];
+    unenrolled: RosterUnenrolledScan[];
+}
+
+export interface MarkResult {
+    result:
+        | 'ingreso_registrado'
+        | 'asistida'
+        | 'parcial'
+        | 'duplicada'
+        | 'sin_ingreso'
+        | 'no_inscrito'
+        | 'dni_invalido';
+    message: string;
+    first_mark: boolean;
+    participant: { id: number; dni: string; full_name: string } | null;
+    marked_at: string | null;
+    permanence: {
+        minutes: number;
+        percent: number;
+        required_percent: number;
+        duration_minutes: number;
+    } | null;
+}
+
+export const ROSTER_STATE_LABELS: Record<RosterState, string> = {
+    presente: 'Asistida',
+    tardanza: 'Tardanza',
