+
+export function formatLimaTime(iso: string | null): string {
+    if (!iso) return '—';
+
+    return new Intl.DateTimeFormat('es-PE', {
+        timeZone: 'America/Lima',
+        hour: '2-digit',
+        minute: '2-digit',
+        second: '2-digit',
+        hour12: false,
+    }).format(new Date(iso));
+}
